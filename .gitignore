# ---------------------------------------------------------------------------
# Generated output.  All of this is reproducible with ./run.sh, so none of it
# belongs in the repository.  data/reference/ is NOT ignored: it is the paper's
# recorded data, which ./compare.py checks against and which --mode reference
# needs.
# ---------------------------------------------------------------------------
results/
outputs/
logs/

# ---------------------------------------------------------------------------
# C++ build products
# ---------------------------------------------------------------------------
*.o
*.a
*.so
src/pistis-sim/sim
src/railway/sim

# Localhost benchmark binaries, generated keys, and per-run logs.  The run
# scripts rebuild these per configuration; keys are regenerated by keygen.
src/protocol-comparison/*/upstream
src/protocol-comparison/*/downstream
src/protocol-comparison/*/keygen/keygen
src/protocol-comparison/*/keygen/keys/
src/protocol-comparison/*/logs_*/
src/network-meas/*/upstream
src/network-meas/*/downstream
src/network-meas/*/grand-master
src/network-meas/*/follower
src/network-meas/*/keygen/keygen
src/network-meas/*/keygen/keys/
src/network-meas/*/logs_*/

# ns-3 writes these into whatever directory the scenario is run from.
track_logs/
pcaps/

# perf record output, left behind by profiling runs of the original code
perf.data
perf.data.old
out.perf

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# Windows "downloaded from the internet" marker files.  The original tree was
# full of these; keep them from coming back.
*:Zone.Identifier
